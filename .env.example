# Chép thành .env rồi điền. .env nằm trong .gitignore: không bao giờ commit file này.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# ---- Website
# Mã để tạo tài khoản quản trị đầu tiên ở /#/setup. Bỏ trống thì server tự sinh và in ra log lúc khởi động.
VIDUB_SETUP_TOKEN=
# Đặt 1 khi chạy sau HTTPS: cookie đăng nhập thêm cờ Secure, bật HSTS.
VIDUB_SECURE_COOKIE=0
# Đặt 1 khi chạy sau reverse proxy (nginx…) để lấy IP thật từ X-Forwarded-For cho nhật ký và chống dò mật khẩu.
VIDUB_TRUST_PROXY=0
